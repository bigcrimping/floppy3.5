# Target: ESP32-S3-WROOM-1-N16R8 (16 MB flash, 8 MB octal PSRAM)

# --- Flash ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- OTA self-update (ota.c, POST /api/ota) ---
# A new image must confirm itself (after WiFi and the controller link are up)
# or the bootloader rolls it back.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Off, so downgrading stays possible.
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=n

# --- PSRAM (octal, N16R8). The 1.44 MB disk image + flux buffer live here. ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Keep large lwIP/WiFi buffers in internal SRAM; PSRAM is reserved for the image.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# --- FreeRTOS: dual core, tasks pinned per architecture doc §4 ---
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_HZ=1000

# --- FatFs (floppy image + SD card, long filenames) ---
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_CODEPAGE_437=y

# --- HTTP server + mDNS ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_LWIP_LOCAL_HOSTNAME="floppy"

# --- Log level ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Accept the NTP server offered by DHCP (esp_netif_sntp server_from_dhcp).
# Without this esp_netif_sntp_init() refuses the config with
# ESP_ERR_INVALID_ARG. pool.ntp.org stays configured as the fallback for
# routers that offer none.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
